{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "M590Bridge",
  "version": "0.1.0",
  "identifier": "app.m590bridge.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "M590Bridge",
        "width": 460,
        "height": 760,
        "minWidth": 400,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "focus": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "category": "Utility",
    "shortDescription": "Local clipboard and file bridge",
    "longDescription": "Synchronizes text, images, and small files between paired Linux and Windows computers over a local network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
